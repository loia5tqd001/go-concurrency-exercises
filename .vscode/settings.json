{
  "go.gopath": "~/go",
  "go.toolsGopath": "~/go",

  "go.useLanguageServer": true,
  "go.lintOnSave": "package",
  "go.vetOnSave": "package",
  "go.testFlags": ["-race"],
  "go.testTimeout": "60s",

  "gopls": {
    "ui.diagnostic.staticcheck": true
  },
  "[go]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go"
  },
  "[go.mod]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go"
  }
}
